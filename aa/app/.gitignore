# Dependencias de Node.js
node_modules/

# Archivos de configuración de entorno
.env

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Directorios de caché
.cache/

# Archivos de instalación de dependencias de herramientas
package-lock.json
yarn.lock

# Archivos generados por el sistema operativo
.DS_Store  # macOS
Thumbs.db   # Windows

# Archivos generados por el IDE
.idea/      # JetBrains/IntelliJ
.vscode/    # Visual Studio Code

# Archivos generados por el entorno de test (si usas Jest o Mocha, por ejemplo)
coverage/

# Carpeta de distribución (si existe)
dist/
build/
